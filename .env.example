# ============================================================
# MDK CRYPTO TRADING - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# TRADING SETTINGS
# ------------------------------------------------------------
TRADING_MODE=DEMO # Trading mode: DEMO | REAL
  # - DEMO: Utilizza Binance Demo Trading (demo.binance.com) - ordini sandbox reali
  # - REAL: Trading reale con fondi reali (richiede KILL_SWITCH=0)
  # - TRADING_MODE è obbligatoria: se manca o non è valida, il bot non parte
KILL_SWITCH=0 # Kill switch: Quando impostato a 1, tutti gli ordini sono forzati a HOLD indipendentemente dalla decisione dell'IA
CYCLE_INTERVAL_SECONDS=5400 # Intervallo tra cicli in secondi (obbligatorio, fail-fast se manca)

# ------------------------------------------------------------
# LOG LEVEL
# ------------------------------------------------------------
LOG_LEVEL=INFO # Log level: DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------
# AI / MACHINE LEARNING
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_claude_api_key

# ------------------------------------------------------------
# TELEGRAM
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------
# BINANCE
# ------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_DEMO_API_KEY=your_binance_demo_api_key
BINANCE_DEMO_SECRET_KEY=your_binance_demo_secret_key
BINANCE_DEMO_BASE_URL=https://demo-api.binance.com/api
